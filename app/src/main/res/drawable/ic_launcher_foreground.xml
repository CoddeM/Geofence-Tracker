<?xml version="1.0" encoding="utf-8"?>
<!-- A map pin standing inside a geofence ring, with one member dot outside the ring.
     Everything stays inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Geofence ring on the ground -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="M30,67a24,9 0 1,0 48,0a24,9 0 1,0 -48,0z" />
    <path
        android:pathData="M30,67a24,9 0 1,0 48,0a24,9 0 1,0 -48,0z"
        android:strokeWidth="2.5"
        android:strokeColor="#CCFFFFFF" />

    <!-- Pin (Material "location on" shape, scaled 1.6x, tip at 54,67) -->
    <group
        android:scaleX="1.6"
        android:scaleY="1.6"
        android:translateX="34.8"
        android:translateY="31.8">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13c0,-3.87 -3.13,-7 -7,-7z" />
        <path
            android:fillColor="#FF0E7C74"
            android:pathData="M12,9m-2.6,0a2.6,2.6 0 1,1 5.2,0a2.6,2.6 0 1,1 -5.2,0" />
    </group>

    <!-- A member who has left the zone -->
    <path
        android:fillColor="#FFFFB74D"
        android:pathData="M76,72m-4,0a4,4 0 1,1 8,0a4,4 0 1,1 -8,0" />
</vector>
